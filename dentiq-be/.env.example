PORT=4000
# MongoDB Atlas connection string. Use "memory" for a throwaway in-memory DB (dev only).
MONGO_URI=memory
JWT_SECRET=change-me-to-a-long-random-string
# Password for the doctor's login (used by `npm run seed` to create the account)
DOCTOR_PASSWORD=change-me
# Frontend origin allowed by CORS
CLIENT_ORIGIN=http://localhost:5173
TZ_NAME=Asia/Kolkata
# Optional: only if mongodb+srv lookups fail locally (some Windows networks)
# DNS_SERVERS=8.8.8.8,1.1.1.1

# WhatsApp Cloud API (optional). Leave blank to use tap-to-send reminders from the app.
WA_TOKEN=
WA_PHONE_NUMBER_ID=
# Approved template names. Body params: {{1}} name, {{2}} date, {{3}} time, {{4}} clinic
WA_TEMPLATE_APPOINTMENT=appointment_reminder
WA_TEMPLATE_RECALL=recall_reminder
WA_TEMPLATE_LANG=en
